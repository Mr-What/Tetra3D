;DIMPLE_PROBE_SCALED DX=-4.5 DY=0.866
;DIMPLE_PROBE_SCALED DX=-5 DY=0
;DIMPLE_PROBE_SCALED DX=-4.5 DY=-0.866
;DIMPLE_PROBE_SCALED DX=-4 DY=-1.732
;DIMPLE_PROBE_SCALED DX=-3.5 DY=-2.598
;DIMPLE_PROBE_SCALED DX=-3 DY=-3.464
;DIMPLE_PROBE_SCALED DX=-2.5 DY=-4.330
;DIMPLE_PROBE_SCALED DX=-1.5 DY=-4.330
;DIMPLE_PROBE_SCALED DX=-0.5 DY=-4.330
;DIMPLE_PROBE_SCALED DX=0.5 DY=-4.330
;DIMPLE_PROBE_SCALED DX=1.5 DY=-4.330
;DIMPLE_PROBE_SCALED DX=2.5 DY=-4.330
;DIMPLE_PROBE_SCALED DX=3 DY=-3.464
;DIMPLE_PROBE_SCALED DX=3.5 DY=-2.598
;DIMPLE_PROBE_SCALED DX=4  DY=-1.732
;DIMPLE_PROBE_SCALED DX=4.5 DY=-0.866 ; end of 6 dimple edge hex grid
TLOG PREFIX="DIMPLE" MSG="plate C probe done."
G0 Z20 F6000
HOMEPOS
MOTORS_OFF
