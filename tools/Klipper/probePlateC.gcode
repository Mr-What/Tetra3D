;DIMPLE_PROBE_SCALED DX=5 DY=0
;DIMPLE_PROBE_SCALED DX=4.5 DY=0.866
;DIMPLE_PROBE_SCALED DX=4 DY=1.732
;DIMPLE_PROBE_SCALED DX=3.5 DY=2.598
;DIMPLE_PROBE_SCALED DX=3 DY=3.464
;DIMPLE_PROBE_SCALED DX=2.5 DY=4.330
