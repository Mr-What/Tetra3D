; Generic.  Edit SET_PATTERN_SCALE command as needed
; 37 point hex grid goes out to radius=3.  Set SCALE to 1/3 desired radius
SET_PATTERN_SCALE SCALE=23 ; envelope around 78mm for 271mm arms

HOME
G90 ; absolute positions
G1 X0 Y0 Z30 F5000
M204 S100 ; very gentle accel limit for bed probe
G1 X0 Y0 Z10 F1200
SET_GCODE_VARIABLE MACRO=USER_VARS VARIABLE=probez_z VALUE=3
SET_GCODE_VARIABLE MACRO=USER_VARS VARIABLE=probez_f VALUE=3000

SET_VELOCITY_LIMIT ACCEL=200 SQUARE_CORNER_VELOCITY=2
;SET_TMC_CURRENT STEPPER=stepper_a CURRENT=0.5
;SET_TMC_CURRENT STEPPER=stepper_b CURRENT=0.2  ; smaller steppers get hot
;SET_TMC_CURRENT STEPPER=stepper_c CURRENT=0.2

PROBEZ X=0 Y=0 F=2000    ; pass 1
SCALED_PROBEZ X=1    Y=0
SCALED_PROBEZ X=0.5  Y=0.866
SCALED_PROBEZ X=-0.5 Y=0.866
SCALED_PROBEZ X=-1   Y=0
SCALED_PROBEZ X=-0.5 Y=-0.866
SCALED_PROBEZ X=0.5  Y=-0.866
SCALED_PROBEZ X=2    Y=0
SCALED_PROBEZ X=1.5  Y=0.866
SCALED_PROBEZ X=1    Y=1.732
SCALED_PROBEZ X=0    Y=1.732
SCALED_PROBEZ X=-1   Y=1.732
SCALED_PROBEZ X=-1.5 Y=0.866
SCALED_PROBEZ X=-2   Y=0
SCALED_PROBEZ X=-1.5 Y=-0.866
SCALED_PROBEZ X=-1   Y=-1.732
SCALED_PROBEZ X=0    Y=-1.732
SCALED_PROBEZ X=1    Y=-1.732
SCALED_PROBEZ X=1.5  Y=-0.866
SCALED_PROBEZ X=3    Y=0
SCALED_PROBEZ X=2.5  Y=0.866
SCALED_PROBEZ X=2    Y=1.732
SCALED_PROBEZ X=1.5  Y=2.598
SCALED_PROBEZ X=0.5  Y=2.598
SCALED_PROBEZ X=-0.5 Y=2.598
SCALED_PROBEZ X=-1.5 Y=2.598
SCALED_PROBEZ X=-2   Y=1.732
SCALED_PROBEZ X=-2.5 Y=0.866
SCALED_PROBEZ X=-3   Y=0
SCALED_PROBEZ X=-2.5 Y=-0.866
SCALED_PROBEZ X=-2   Y=-1.732
SCALED_PROBEZ X=-1.5 Y=-2.598
SCALED_PROBEZ X=-0.5 Y=-2.598
SCALED_PROBEZ X=0.5  Y=-2.598
SCALED_PROBEZ X=1.5  Y=-2.598
SCALED_PROBEZ X=2    Y=-1.732
SCALED_PROBEZ X=2.5  Y=-0.866
REL Z=8

G0 X0 Y0 Z12 F3000
PROBEZ X=0 Y=0 F=1200  ; pass 2
SCALED_PROBEZ X=1    Y=0
SCALED_PROBEZ X=0.5  Y=0.866
SCALED_PROBEZ X=-0.5 Y=0.866
SCALED_PROBEZ X=-1   Y=0
SCALED_PROBEZ X=-0.5 Y=-0.866
SCALED_PROBEZ X=0.5  Y=-0.866
SCALED_PROBEZ X=2    Y=0
SCALED_PROBEZ X=1.5  Y=0.866
SCALED_PROBEZ X=1    Y=1.732
SCALED_PROBEZ X=0    Y=1.732
SCALED_PROBEZ X=-1   Y=1.732
SCALED_PROBEZ X=-1.5 Y=0.866
SCALED_PROBEZ X=-2   Y=0
SCALED_PROBEZ X=-1.5 Y=-0.866
SCALED_PROBEZ X=-1   Y=-1.732
SCALED_PROBEZ X=0    Y=-1.732
SCALED_PROBEZ X=1    Y=-1.732
SCALED_PROBEZ X=1.5  Y=-0.866
SCALED_PROBEZ X=3    Y=0
SCALED_PROBEZ X=2.5  Y=0.866
SCALED_PROBEZ X=2    Y=1.732
SCALED_PROBEZ X=1.5  Y=2.598
SCALED_PROBEZ X=0.5  Y=2.598
SCALED_PROBEZ X=-0.5 Y=2.598
SCALED_PROBEZ X=-1.5 Y=2.598
SCALED_PROBEZ X=-2   Y=1.732
SCALED_PROBEZ X=-2.5 Y=0.866
SCALED_PROBEZ X=-3   Y=0
SCALED_PROBEZ X=-2.5 Y=-0.866
SCALED_PROBEZ X=-2   Y=-1.732
SCALED_PROBEZ X=-1.5 Y=-2.598
SCALED_PROBEZ X=-0.5 Y=-2.598
SCALED_PROBEZ X=0.5  Y=-2.598
SCALED_PROBEZ X=1.5  Y=-2.598
SCALED_PROBEZ X=2    Y=-1.732
SCALED_PROBEZ X=2.5  Y=-0.866
REL Z=8

G0 X0 Y0 Z12 F3000
PROBEZ X=0 Y=0  ; pass 3
SCALED_PROBEZ X=1    Y=0
SCALED_PROBEZ X=0.5  Y=0.866
SCALED_PROBEZ X=-0.5 Y=0.866
SCALED_PROBEZ X=-1   Y=0
SCALED_PROBEZ X=-0.5 Y=-0.866
SCALED_PROBEZ X=0.5  Y=-0.866
SCALED_PROBEZ X=2    Y=0
SCALED_PROBEZ X=1.5  Y=0.866
SCALED_PROBEZ X=1    Y=1.732
SCALED_PROBEZ X=0    Y=1.732
SCALED_PROBEZ X=-1   Y=1.732
SCALED_PROBEZ X=-1.5 Y=0.866
SCALED_PROBEZ X=-2   Y=0
SCALED_PROBEZ X=-1.5 Y=-0.866
SCALED_PROBEZ X=-1   Y=-1.732
SCALED_PROBEZ X=0    Y=-1.732
SCALED_PROBEZ X=1    Y=-1.732
SCALED_PROBEZ X=1.5  Y=-0.866
SCALED_PROBEZ X=3    Y=0
SCALED_PROBEZ X=2.5  Y=0.866
SCALED_PROBEZ X=2    Y=1.732
SCALED_PROBEZ X=1.5  Y=2.598
SCALED_PROBEZ X=0.5  Y=2.598
SCALED_PROBEZ X=-0.5 Y=2.598
SCALED_PROBEZ X=-1.5 Y=2.598
SCALED_PROBEZ X=-2   Y=1.732
SCALED_PROBEZ X=-2.5 Y=0.866
SCALED_PROBEZ X=-3   Y=0
SCALED_PROBEZ X=-2.5 Y=-0.866
SCALED_PROBEZ X=-2   Y=-1.732
SCALED_PROBEZ X=-1.5 Y=-2.598
SCALED_PROBEZ X=-0.5 Y=-2.598
SCALED_PROBEZ X=0.5  Y=-2.598
SCALED_PROBEZ X=1.5  Y=-2.598
SCALED_PROBEZ X=2    Y=-1.732
SCALED_PROBEZ X=2.5  Y=-0.866

SET_VELOCITY_LIMIT ACCEL=4000 SQUARE_CORNER_VELOCITY=5
M204 S2000 ; set global accel limit
;SET_TMC_CURRENT STEPPER=stepper_a CURRENT=0.8
;SET_TMC_CURRENT STEPPER=stepper_b CURRENT=0.5
;SET_TMC_CURRENT STEPPER=stepper_c CURRENT=0.5

G0 X0 Y0 Z20 F6000
HOMEPOS
M84 ;  motors off
