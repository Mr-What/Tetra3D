;SET_GCODE_VARIABLE MACRO=_CROSS_PROBE_STATE VARIABLE=stop VALUE=0.3
;SET_GCODE_VARIABLE MACRO=_CROSS_PROBE_STATE VARIABLE=initial_step VALUE=2
; minimize travel between probes.  z offset more likely to stay above plate
HOME
TLOG PREFIX="DIMPLE" MSG="starting probe for plate B"
G0 Z12 F3000
DIMPLE_PROBE_SET SCALE=20
DIMPLE_PROBE_SCALED DX=0  DY=0
DIMPLE_PROBE_SCALED DX=0  DY=1
DIMPLE_PROBE_SCALED DX=-1 DY=1
DIMPLE_PROBE_SCALED DX=-1 DY=0
DIMPLE_PROBE_SCALED DX=-1 DY=-1
DIMPLE_PROBE_SCALED DX=0  DY=-1
DIMPLE_PROBE_SCALED DX=1  DY=-1
DIMPLE_PROBE_SCALED DX=1  DY=0
DIMPLE_PROBE_SCALED DX=1  DY=1
DIMPLE_PROBE_SCALED DX=2  DY=1
DIMPLE_PROBE_SCALED DX=1  DY=2
DIMPLE_PROBE_SCALED DX=0  DY=2
DIMPLE_PROBE_SCALED DX=-1 DY=2
DIMPLE_PROBE_SCALED DX=-2 DY=1
DIMPLE_PROBE_SCALED DX=-2 DY=0
DIMPLE_PROBE_SCALED DX=-2 DY=-1
DIMPLE_PROBE_SCALED DX=-1 DY=-2
DIMPLE_PROBE_SCALED DX=0  DY=-2
DIMPLE_PROBE_SCALED DX=1  DY=-2
DIMPLE_PROBE_SCALED DX=2  DY=-1
DIMPLE_PROBE_SCALED DX=2  DY=0
TLOG PREFIX="DIMPLE" MSG="plate B probe done."
G0 Z20 F6000
HOMEPOS
MOTORS_OFF
