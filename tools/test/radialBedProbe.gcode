HOME
G90 ; absolute positions
GET_POSITION
QUERY_ENDSTOPS
G1 X0 Y0 Z30 F5000
M204 S100 ; very gentle accel limit for bed probe
G1 X0 Y0 Z10 F1200
SET_GCODE_VARIABLE MACRO=USER_VARS VARIABLE=probez_z VALUE=3
SET_GCODE_VARIABLE MACRO=USER_VARS VARIABLE=probez_f VALUE=3000

SET_VELOCITY_LIMIT ACCEL=200 SQUARE_CORNER_VELOCITY=2
SET_TMC_CURRENT STEPPER=stepper_a CURRENT=0.5
SET_TMC_CURRENT STEPPER=stepper_b CURRENT=0.2  ; smaller steppers get hot
SET_TMC_CURRENT STEPPER=stepper_c CURRENT=0.2

