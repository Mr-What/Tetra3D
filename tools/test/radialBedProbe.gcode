REL Z=10
SET_VELOCITY_LIMIT ACCEL=4000 SQUARE_CORNER_VELOCITY=5
M204 S2000 ; set global accel limit
SET_TMC_CURRENT STEPPER=stepper_a CURRENT=0.8
SET_TMC_CURRENT STEPPER=stepper_b CURRENT=0.5
